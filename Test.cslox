// Test of function definitions
fun helloWorld(testStr)
{
	if (testStr == "")
	{
		print "Hello world!";
	}

	print testStr;
}

helloWorld("");
helloWorld("This is a test!");

// Example of closures working
fun counter(howManyToCount)
{
	var a = 0;
	fun count()
	{
		print a;
		a = a + 1;		
	}

	while(a <= howManyToCount)
	{
		count();
	}
}

counter(10);

// Classes
class Foo
{
	init() {
		print "I'm in a class!";
	}

	bar() {
		var x = this.a + this.b;
		print x;
	}
}

var myClass = Foo();
myClass.a = 10;
myClass.b = 20;
myClass.bar();