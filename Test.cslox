// Functions
fun helloWorld(testStr)
{
	if (testStr == "")
	{
		print "Hello world!";
	}

	print testStr;
}

helloWorld("");
helloWorld("This is a test!");


// Closures
var a = 5;
fun counter()
{
	fun CheckA()
	{
		print a;
	}
	CheckA(); // Should print 5
	var a = 10;
	CheckA(); // Should print 5 still
	print a;  // Should print 10
}

counter();


// Classes
class Foo
{
	init() {
		print "I'm in a class!";
	}

	bar() {
		var x = this.a + this.b;
		print x;
	}
}

var myClass = Foo();
myClass.a = 10;
myClass.b = 20;
myClass.bar();


// Inheritance
class BarSuper
{
	sayHi()
	{
		print "I'm in the superclass!";
	}
}

class Bar < BarSuper
{
}

var myBar = Bar();
myBar.sayHi(); // Should print the message above